# Copy this file to ".env" in the same folder and fill in your own values.
# NEVER commit the real ".env" file to Git or share it publicly.

# Your OpenAI API key (starts with "sk-...").
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which OpenAI model the Copilot uses. gpt-5-mini is a good default:
# fast and inexpensive, well suited to this kind of structured task.
OPENAI_MODEL=gpt-5-mini

# Port the backend server listens on.
PORT=3000

# Which frontend origin(s) are allowed to call this backend.
# For local testing, "*" is fine. For production, set this to your
# GitHub Pages URL, e.g. https://yourusername.github.io
ALLOWED_ORIGIN=*
